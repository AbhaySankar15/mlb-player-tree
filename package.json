{
  "name": "mlb-player-tree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "tsc --noEmit && tsc -p tsconfig.api.json && vitest run && .venv/bin/python -m pytest -q && vite build",
    "data": ".venv/bin/python scripts/download_data.py && .venv/bin/python scripts/export_graph.py && .venv/bin/python scripts/build_profiles.py && .venv/bin/python scripts/validate_data.py"
  },
  "dependencies": {
    "graphology": "0.26.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
